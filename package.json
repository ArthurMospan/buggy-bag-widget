{
  "name": "buggy-bag-widget",
  "version": "0.1.0",
  "description": "In-app bug reporting overlay with screenshot, annotations, and automatic tech context",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "bug-reporting",
    "qa",
    "overlay",
    "screenshot",
    "react",
    "debugging",
    "ai"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "postbuild": "node -e \"require('fs').copyFileSync('dist/buggy-bag-standalone.global.js', '../buggy-bag-portal/public/buggy-bag-standalone.js')\"",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "html-to-image": "1.11.13",
    "html2canvas": "^1.4.1",
    "konva": "^9.3.19",
    "lucide-react": "^0.468.0",
    "react-konva": "^18.2.10",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ArthurMospan/buggy-bag-widget.git"
  },
  "homepage": "https://github.com/ArthurMospan/buggy-bag-widget#readme"
}
